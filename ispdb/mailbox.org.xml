<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="mailbox.org">
    <domain>mailbox.org</domain>
    <displayName>mailbox.org</displayName>
    <displayShortName>mailbox.org</displayShortName>
    <!-- Server settings as published by mailbox.org:
         https://kb.mailbox.org/de/privat/e-mail/e-mail-konfiguration/
         IMAP imap.mailbox.org 993 (SSL/TLS), SMTP smtp.mailbox.org 465 (SSL/TLS) or 587 (STARTTLS),
         username = the primary e-mail address, password = the mailbox password.
         mailbox.org also serves this configuration itself at
         https://autoconfig.mailbox.org/mail/config-v1.1.xml; the IMAP 143/STARTTLS
         and POP3 servers below are taken from there. -->
    <incomingServer type="imap">
      <hostname>imap.mailbox.org</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <incomingServer type="imap">
      <hostname>imap.mailbox.org</hostname>
      <port>143</port>
      <socketType>STARTTLS</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <incomingServer type="pop3">
      <hostname>pop3.mailbox.org</hostname>
      <port>995</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <incomingServer type="pop3">
      <hostname>pop3.mailbox.org</hostname>
      <port>110</port>
      <socketType>STARTTLS</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>smtp.mailbox.org</hostname>
      <port>465</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </outgoingServer>
    <outgoingServer type="smtp">
      <hostname>smtp.mailbox.org</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </outgoingServer>
    <documentation url="https://kb.mailbox.org/de/privat/e-mail/e-mail-konfiguration/">
      <descr lang="de">E-Mail-Konfiguration</descr>
      <descr>E-mail configuration</descr>
    </documentation>
    <!-- With two-factor authentication enabled, external programs need an application password:
         https://kb.mailbox.org/de/privat/sicherheit-und-privatsphaere/applikationspasswoerter-fuer-externe-programme/ -->
    <enable visiturl="https://kb.mailbox.org/de/privat/sicherheit-und-privatsphaere/applikationspasswoerter-fuer-externe-programme/">
      <instruction>If two-factor authentication is enabled for your account, e-mail programs need an application password instead of your mailbox password.</instruction>
      <instruction lang="de">Bei aktivierter Zwei-Faktor-Authentifizierung benötigen E-Mail-Programme ein Applikationspasswort statt des Postfach-Passworts.</instruction>
    </enable>
  </emailProvider>
</clientConfig>
