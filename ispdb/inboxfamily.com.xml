<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="inboxfamily.com">
    <!-- MX domain: customers use their own domains, with MX s1.inboxfamily.com -->
    <domain>inboxfamily.com</domain>
    <displayName>InboxFamily</displayName>
    <displayShortName>InboxFamily</displayShortName>
    <incomingServer type="imap">
      <hostname>s1.inboxfamily.com</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>s1.inboxfamily.com</hostname>
      <port>465</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
    <documentation url="https://inboxfamily.com/help">
      <descr lang="en">Mail app settings</descr>
    </documentation>
  </emailProvider>
</clientConfig>
