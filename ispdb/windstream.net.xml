<clientConfig version="1.1">
  <emailProvider id="windstream.net">
    <domain>windstream.net</domain>
    <displayName>Windstream Email</displayName>
    <displayShortName>Windstream Email</displayShortName>
    <incomingServer type="imap">
      <hostname>imap.windstream.net</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>smtp.windstream.net</hostname>
      <port>465</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </outgoingServer>
    <documentation url="https://www.gokinetic.com/support/my-account/email-101/what-server-settings-do-i-use-for-windstream-email">
      <descr lang="en">Windstream (Kinetic) Email IMAP and SMTP settings</descr>
    </documentation>
  </emailProvider>
</clientConfig>
